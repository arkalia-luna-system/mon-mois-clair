# Copier vers keystore.properties (non versionné) et renseigner les secrets.
# Générer le .jks : keytool -genkeypair -v -keystore release/monmoisclair-release.jks \
#   -alias monmoisclair -keyalg RSA -keysize 2048 -validity 10000
storeFile=release/monmoisclair-release.jks
storePassword=CHANGE_ME
keyAlias=monmoisclair
keyPassword=CHANGE_ME
