# Copier vers keystore.properties (non versionné) et renseigner les secrets.
# Générer le .jks : keytool -genkeypair -v -keystore release/monmoisclair-release.jks \
#   -alias monmoisclair -keyalg RSA -keysize 2048 -validity 10000
#
# CI (GitHub Actions → Play Internal) — secrets homonymes, jamais commités :
#   RELEASE_KEYSTORE_BASE64 / RELEASE_KEYSTORE_PASSWORD /
#   RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD / PLAY_SERVICE_ACCOUNT_JSON
# Voir docs/PLAY_INTERNAL_TESTING.md § CI auto-deploy.
storeFile=release/monmoisclair-release.jks
storePassword=CHANGE_ME
keyAlias=monmoisclair
keyPassword=CHANGE_ME
