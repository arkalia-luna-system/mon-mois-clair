<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MonMoisClair" parent="Theme.Material3.Light.NoActionBar">
        <!-- Crème dès le splash : évite le flash blanc Material. -->
        <item name="android:windowBackground">@color/paper_cream</item>
        <!-- Statut crème = même papier que l’app (pas de bandeau blanc). -->
        <item name="android:statusBarColor">@color/paper_cream</item>
        <item name="android:navigationBarColor">@color/paper_cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- windowLightNavigationBar : values-v27 (API 27+). -->
    </style>

    <!-- Android 12+ SplashScreen API — même papier, même M que l’icône. -->
    <style name="Theme.MonMoisClair.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_brand_m</item>
        <item name="postSplashScreenTheme">@style/Theme.MonMoisClair</item>
    </style>
</resources>
