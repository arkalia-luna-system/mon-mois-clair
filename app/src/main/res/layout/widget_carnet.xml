<?xml version="1.0" encoding="utf-8"?>
<!--
  RemoteViews : classes système seulement.
  Interdit : View nu, police custom embarquée
  (One UI InflateException → Impossible d'ajouter).
  Police montant = serif système (pas Source Serif embarquée).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_carnet_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- WDG01 : libellé discret — le montant commande. -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:text="Reste"
        android:textAllCaps="false"
        android:textColor="@color/widget_muted"
        android:textSize="14sp" />

    <!-- WDG02 : serif système uniquement. -->
    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="0.92"
        android:maxLines="1"
        android:text="—"
        android:textColor="@color/widget_ink"
        android:textSize="34sp" />

    <!-- Filet ImageView (séparateur nu refusé par le host). -->
    <ImageView
        android:id="@+id/widget_rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@color/widget_rule"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:text="Ouvrir le carnet"
        android:textColor="@color/widget_muted"
        android:textSize="15sp" />
</LinearLayout>
